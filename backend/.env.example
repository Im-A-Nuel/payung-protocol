# Shared
DATABASE_URL=postgres://payung:payung@localhost:5432/payung?sslmode=disable
ENV=development

# Chain (opBNB testnet)
OPBNB_RPC=https://opbnb-testnet-rpc.bnbchain.org
OPBNB_CHAIN_ID=5611
POOL_ADDRESS=0xyourDeployedPayungPoolAddress
IDRP_ADDRESS=0xyourDeployedIDRPAddress
DEPLOY_BLOCK=0

# cmd/oracle: signer with ORACLE_ROLE on PayungPool
ORACLE_PRIVATE_KEY=0xyourOraclePrivateKeyHere

# cmd/api
PORT=8080
ADMIN_KEY=change-me-in-deployment
# Same oracle signer, used by POST /admin/simulate-rain and /admin/oracle/run.
# ORACLE_PRIVATE_KEY is required above.
# Separate signer with FAUCET_ROLE on IDRP (never the same key as the admin/oracle key).
FAUCET_PRIVATE_KEY=0xyourFaucetPrivateKeyHere

# Phase 4 (AI pricing/explanations), not read yet by Phase 1-2 code:
# ANTHROPIC_API_KEY=
