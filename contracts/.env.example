# Deployer / contract admin private key (0x-prefixed). NEVER commit the real value.
PRIVATE_KEY=0xyourprivatekeyhere

# Backend oracle signer address; granted ORACLE_ROLE at deploy time.
ORACLE_ADDRESS=0xyourOracleAddressHere

# opBNB testnet
OPBNB_RPC=https://opbnb-testnet-rpc.bnbchain.org

# BscScan verification (opBNB testnet uses the same BscScan API key scheme)
BSCSCAN_API_KEY=yourBscScanApiKeyHere
