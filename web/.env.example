# Go API base URL, including the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:8080/v1

# Privy app ID (console.privy.io). Without it the app runs read-only in
# preview mode and buying is disabled.
NEXT_PUBLIC_PRIVY_APP_ID=

# Address to read as, for preview mode only. Ignored once Privy is set.
NEXT_PUBLIC_PREVIEW_ADDRESS=

# Chain. Defaults below are opBNB testnet; override for a local anvil node.
NEXT_PUBLIC_CHAIN_ID=5611
NEXT_PUBLIC_RPC_URL=https://opbnb-testnet-rpc.bnbchain.org
NEXT_PUBLIC_EXPLORER_URL=https://opbnb-testnet.bscscan.com

# Deployed contracts.
NEXT_PUBLIC_POOL_ADDRESS=
NEXT_PUBLIC_IDRP_ADDRESS=
